# Copia este fichero a .env y rellénalo. Docker Compose lee automáticamente el
# .env de la raíz del proyecto al arrancar. NO subas el .env: está en .gitignore.
#
#     cp .env.example .env
#     docker compose up --build

# --- URL pública -------------------------------------------------------------
# Raíz del sitio para canonical, og:url, manifest y JSON-LD.
# Si se deja vacía, la app usa request.url_root: funciona sin configurar nada
# en local, pero detrás de un reverse proxy puede devolver el host interno.
PUBLIC_URL=

# --- Servidor -----------------------------------------------------------------
# Nº de workers de gunicorn. Cada worker es un proceso con su propia memoria,
# así que el límite de peticiones de /shorten (20/min) se multiplica por este
# número. Con 4 son hasta 80/min; es una guarda best-effort, la garantía dura
# de que /shorten solo acepta URLs emitidas por esta app es la firma HMAC.
WORKERS=4

# --- Acortado de URLs (short.io), opcional ------------------------------------
# Sin estas dos variables el botón de acortar no aparece y la app funciona
# exactamente igual que sin acortado.
#
# SHORT_IO_API_KEY: clave SECRETA, en Integrations & API del panel de short.io.
#                   Nunca la pongas en otro sitio: se usa solo en el servidor.
SHORT_IO_API_KEY=

# SHORT_IO_DOMAIN: dominio propio ya añadido a tu cuenta de short.io.
SHORT_IO_DOMAIN=